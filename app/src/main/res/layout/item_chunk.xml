<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_source_card"
    android:orientation="vertical"
    android:padding="12dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvChunkId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:fontFamily="sans-serif-black"
            android:text="Chunk #01"
            android:textColor="@color/cyan_accent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvChunkPage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:fontFamily="sans-serif-medium"
            android:text="Page 1"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tvChunkText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="sans-serif"
        android:lineSpacingExtra="2dp"
        android:text="Sample extracted chunk text content..."
        android:textColor="@color/text_primary"
        android:textSize="12sp" />

</LinearLayout>
